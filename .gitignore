# Dependencies
node_modules/

# Next.js build output
/.next/
/out/

# Build artifacts. These are anchored to the repo root on purpose: an unanchored
# "coverage/" also matches src/app/api/coverage/, which silently excluded a real
# route handler from the first commit.
/build/
/coverage/
*.tsbuildinfo
next-env.d.ts

# Local environment. .env.example is committed; real values never are.
.env
.env.local
.env*.local

# OS
.DS_Store
Thumbs.db

# The CMS Part D formulary snapshot under src/sources/content/coverage/ IS
# committed, for the same reason as the plan directory below: the app reads it
# at runtime and the Vercel build has no network access to CMS and no pipeline
# checkout, so an ignored file is simply absent in production.
#
# It used to be ignored here as "operator-generated". That was the last link in
# a four-part chain that left the coverage flow telling every user it was "not
# connected to any formulary database" while 979 real rows sat on disk: the
# pipeline emitted its own shape, content:sync never copied it, this rule kept
# it out of the repository, and the lookup passed every drug's RXCUI at once.
#
# Regenerate it with `npm run content:sync` (which requires
# `cd data-pipeline && npm run app:snapshot` first). Never edit it by hand.

# Vercel CLI project link metadata (local to this machine's deployments).
.vercel

# Vendored pipeline output under src/sources/content/ IS committed, including
# the 1.6 MB Part D plan directory. The app imports it directly, so the Vercel
# build needs it present; regenerate with `npm run content:sync`, never by
# hand. It changes only when CMS publishes a new monthly release.
