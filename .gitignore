# Dependencies
node_modules/

# Next.js build output
/.next/
/out/

# Build artifacts. These are anchored to the repo root on purpose: an unanchored
# "coverage/" also matches src/app/api/coverage/, which silently excluded a real
# route handler from the first commit.
/build/
/coverage/
*.tsbuildinfo
next-env.d.ts

# Local environment. .env.example is committed; real values never are.
.env
.env.local
.env*.local

# OS
.DS_Store
Thumbs.db

# The CMS Part D formulary snapshot and product concept identities under
# src/sources/content/coverage/ ARE committed, for the same reason as the plan
# directory below: the app imports them, and the Vercel build has no CMS access
# and no pipeline checkout, so an ignored file is simply absent in production.
# That is what this rule used to do, and every coverage check answered "not
# connected to any formulary database" while 979 real rows sat in the
# pipeline's committed output. Regenerate with `npm run content:sync`.

# Vercel CLI project link metadata (local to this machine's deployments).
.vercel

# Vendored pipeline output under src/sources/content/ IS committed, including
# the 1.6 MB Part D plan directory. The app imports it directly, so the Vercel
# build needs it present; regenerate with `npm run content:sync`, never by
# hand. It changes only when CMS publishes a new monthly release.
