# ---------------------------------------------------------------------------
# MediZ — environment configuration
#
# Copy to .env.local and fill in. Placeholders only in this file; never commit
# a real secret. Every variable below is OPTIONAL: with none of them set the
# app runs and is honest about what is not connected.
# ---------------------------------------------------------------------------

# --- App mode ---------------------------------------------------------------
# Which audience the root path ("/") sends someone to. /doctor and
# /medications/... are ALWAYS reachable directly regardless of this setting —
# it only picks what the bare domain opens to, so the same build can be
# deployed twice under two Vercel domains/projects: one for the real patient
# link (leave unset) and one for the doctor demo (set to "doctor").
#
# "patient" (default) | "doctor"
APP_MODE=patient


# --- Public origin ---------------------------------------------------------
# The absolute origin used to build share URLs and QR codes. Must be https in
# deployment (localhost is allowed for development). Set this before sharing or
# deploying, or shared links will point at localhost and fail on other devices.
# Path and query are stripped; only the origin is used.
PUBLIC_ORIGIN=https://your-deployment-hostname.example


# --- Assistant (optional) --------------------------------------------------
# Without a credential the assistant runs in "Label excerpt search" mode:
# deterministic, verbatim label text, explicitly labelled as NOT AI. Setting a
# key enables conversational answers that are still grounded in, and validated
# against, the same retrieved label passages.
#
# "anthropic" | "impiricus" | "none"
ASSISTANT_PROVIDER=anthropic

# Server-side only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Defaults to claude-sonnet-5 when unset.
ANTHROPIC_MODEL=claude-sonnet-5


# --- Impiricus assistant (not implemented) ---------------------------------
# This is an independent prototype. No Impiricus endpoint, schema or credential
# is known to this codebase and none is invented. The adapter in
# src/patient/lib/chat/providers/index.ts is a documented boundary, not a
# working integration: it must be implemented against the official
# specification before these variables do anything.
#
# IMPIRICUS_AUDIENCE must be exactly "patient". A credential authorised only for
# healthcare professionals must not be repurposed for a patient-facing page, so
# the config layer refuses to select this provider otherwise.
# IMPIRICUS_API_BASE_URL=https://api.example-impiricus.invalid
# IMPIRICUS_API_KEY=your-authorised-key
# IMPIRICUS_AUDIENCE=patient


# --- Insurance coverage ----------------------------------------------------
# No real payer, PBM or formulary integration is available to this prototype.
# The coverage flow is fully built and returns "unable to verify".
#
# Sample mode returns clearly-labelled FICTIONAL scenarios so the different
# result states can be demonstrated. It is opt-in, it renders a persistent
# "SAMPLE MODE" banner, and it is never used as a fallback for a failed lookup.
# Leave unset for demos where anyone might mistake sample data for real data.
ENABLE_SAMPLE_COVERAGE=false


# --- Provider referral submission (not implemented) ------------------------
# Unset by default, which means the app transmits and stores NO personal
# information at all and offers verified public contact routes instead.
# Do not set these without a real agreement covering data processing and
# storage — see docs/INTEGRATIONS.md.
# REFERRAL_API_BASE_URL=https://scheduling.example.invalid
# REFERRAL_API_KEY=your-key


# --- Analytics -------------------------------------------------------------
# When true, sanitised events are written to the server log. Nothing is sent to
# any third party. Event names and properties are allow-listed in
# src/shared/lib/analytics/events.ts; chat text, coverage inputs, health
# information and the medication slug are never recorded.
ANALYTICS_ENABLED=false

# Experimental nearby sound sharing: 32 random bytes encoded as 64 hex characters.
# Required in production; use the SAME value on sender/receiver deployments.
# Generate with: openssl rand -hex 32
# Never prefix with NEXT_PUBLIC_. Development uses an ephemeral process key if unset.
NEARBY_SHARE_SECRET=
